# Salin ke .env (lokal) atau isi di Environment Variables Vercel.
# Jangan pernah commit nilai aslinya.

# BotFather
TELEGRAM_BOT_TOKEN=123456789:AAF-contoh-token-ganti-ini

# Rahasia webhook: 1–256 karakter, hanya A-Z a-z 0-9 _ -
# Telegram mengirimnya balik di header X-Telegram-Bot-Api-Secret-Token.
# Buat acak: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # server-only, JANGAN dikirim ke klien

# Token yang dipakai add-in Revit untuk /api/machine/claim dan /report.
# Di PC disimpan terenkripsi DPAPI di %APPDATA%, bukan di dalam DLL.
MACHINE_TOKEN=

# Telegram Mini App (panel web). Wajib HTTPS.
PANEL_URL=https://proyek-kamu.vercel.app/web/index.html

# Hanya untuk scripts/set-commands.ts — dipisah koma.
ADMIN_CHAT_IDS=

# Opsional. Selisih zona waktu kantor terhadap UTC, dalam menit.
# Default 420 (+07:00, WIB). Fungsi Vercel berjalan di UTC, jadi tanpa ini:
#   - hitungan "selesai hari ini" di /status mereset jam 07:00 pagi waktu kerja
#   - jam pada "PC offline sejak …" tercetak tujuh jam lebih awal dari jam dinding
UTC_OFFSET_MINUTES=420
