{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "allowJs": false
  },
  // api/ punya tsconfig sendiri: hasil compile-nya HARUS CommonJS, dan `module`
  // di sini ("ESNext") akan mematikan seluruh endpoint. Lihat api/tsconfig.json.
  "include": ["scripts/**/*.ts"]
}
